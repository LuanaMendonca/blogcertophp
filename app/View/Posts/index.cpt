<h1>Lista de postagens</h1>

<?php if (empty($posts)): ?>

    <p> Nenhuma postagem cadastrada.</p>

<?php else: ?>

    <?php foreach ($posts as $post): ?>

        <h2>
            <?php echo h($post['Post']['titulo']); ?>
        </h2>

        <p>
            <?php echo h($post['Post']['conteudo']); ?>
        </p>

        <p>
            Status: <?php echo h($post['Post']['status']); ?>
        </p>

        <hr>

    <?php endforeach; ?>

<?php endif; ?>
